# ---------------------------------------------------------------
# Configuración de Variables de Entorno - Backend El Volcán
# ---------------------------------------------------------------

# Usuario de Docker Hub para descargar imágenes en AWS EC2 (docker-compose.aws.yml)
DOCKERHUB_USER=tu_usuario_dockerhub

# Cadena de conexión a MongoDB Atlas (Cluster Cloud M0)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/el_volcan_db?retryWrites=true&w=majority
MONGO_DB=el_volcan_db

# Seguridad JWT y comunicación interna entre microservicios
JWT_SECRET=CambiaEstaClaveSecretaJWTDeAlMenos64CaracteresEnProduccionAWS2026
INTERNAL_SERVICE_KEY=CambiaEstaClaveInternaEntreMicroserviciosEnProduccionAWS2026

# Orígenes permitidos en CORS del API Gateway (en AWS agregar IP pública/dominio del frontend)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,*
